# Server configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database configuration
# Local SQLite fallback: sqlite+aiosqlite:///./factoryvision.db
# Production Neon PostgreSQL: postgresql+asyncpg://user:pass@host/dbname?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./factoryvision.db

# JWT Security
JWT_SECRET_KEY=supersecretkey_change_in_production_1234567890!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Settings
# Set to True to bypass YOLOv8 loading & Gemini requests with realistic mocks
SIMULATE_AI=True
GEMINI_API_KEY=your_gemini_api_key
